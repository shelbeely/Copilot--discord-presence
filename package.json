{
  "name": "copilot-discord-presence",
  "version": "1.0.0",
  "description": "Discord Rich Presence daemon for GitHub Copilot cloud agent — shows which repo Copilot is actively coding in",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "copilot-discord-presence": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "bot": "bun run src/bot-daemon.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "copilot",
    "github-copilot",
    "discord",
    "rich-presence",
    "rpc",
    "ai",
    "agent",
    "coding-agent"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shelbeely/Copilot--discord-presence"
  },
  "bugs": {
    "url": "https://github.com/shelbeely/Copilot--discord-presence/issues"
  },
  "homepage": "https://github.com/shelbeely/Copilot--discord-presence#readme",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/bun": "^1.3.8",
    "typescript": "^5.9.3"
  }
}
